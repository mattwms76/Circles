# Copy this file to .env for local development. Environment already supplied by Manus
# always takes precedence over this file; do not replace Manus-injected values.
#
# Browser-safe local defaults only. They are intentionally fake local endpoints, not
# deployable hostnames. A physical device treats localhost as itself: set
# EXPO_PUBLIC_API_BASE_URL to http://<your-computer-LAN-IP>:3000 before device testing.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PACKAGER_PROXY_URL=http://localhost:8081
EXPO_WEB_PREVIEW_URL=http://localhost:8081

# Canonical Manus OAuth/application values. These are browser-safe identifiers/endpoints
# when app.config.ts serializes them, but leave them blank locally unless an authorized
# Manus service deployment supplies them.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=

# Canonical server-only runtime values. Keep every placeholder blank; never commit values.
# MANUS_JWT_SECRET must be a stable, randomly generated UTF-8 secret of at least 32 characters.
# SUPABASE_DATABASE_URL is the sole API datastore connection. Keep it server-only; it must
# use the certificate-verified PostgreSQL session pooler and never enter Expo/browser settings.
MANUS_JWT_SECRET=
SUPABASE_DATABASE_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional for non-production; required before production live operations.
# Use 1-4 comma-separated coturn-compatible turn:/turns: host:port URLs.
# TURN_SHARED_SECRET is provider-generated, at least 32 bytes, and server-only.
# Never rename either setting to EXPO_PUBLIC_* or put its value in app.config.ts.
TURN_SERVER_URLS=
TURN_SHARED_SECRET=

# Managed MySQL is retained only as an optional, read-only migration/rollback source. The API
# never uses DATABASE_URL and never falls back to it when Supabase configuration is unavailable.
DATABASE_URL=

# Optional ownership metadata. OWNER_OPEN_ID is consumed by the server; the public aliases
# are only serialized for client display. Do not use either for authorization decisions in clients.
OWNER_OPEN_ID=
OWNER_NAME=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Optional exact origins used by CORS, OAuth callbacks, cookies, and the Metro preview proxy.
# Use an origin only (scheme + host + optional port), with no path, query, fragment, or credentials.
# EXPO_PACKAGER_PROXY_URL / EXPO_WEB_PREVIEW_URL above are the normal local values.
FRONTEND_ORIGIN=
WEB_ORIGIN=
EXPO_PUBLIC_WEB_URL=
PUBLIC_URL=
OAUTH_CALLBACK_ORIGIN=
API_ORIGIN=
API_BASE_URL=

# Legacy compatibility aliases. Existing deployments may still consume these fallbacks, but
# new Manus deployments must use the canonical MANUS_* values above.
VITE_APP_ID=
JWT_SECRET=
OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
